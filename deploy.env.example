# Copy to a private env file or load these from AWS Secrets Manager / SSM Parameter Store.
# Do not commit real values.

SPRING_PROFILES_ACTIVE=

AUTH_JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
AUTH_JWT_EXPIRATION_MINUTES=60

AUTH_DB_URL=jdbc:mysql://your-db-host:3306/quantity_auth_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
AUTH_DB_DRIVER=com.mysql.cj.jdbc.Driver
AUTH_DB_USERNAME=replace_me
AUTH_DB_PASSWORD=replace_me
AUTH_JPA_DIALECT=org.hibernate.dialect.MySQL8Dialect

GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}
AUTH_OAUTH2_REDIRECT_URI=https://your-frontend-domain/oauth-success

APP_CORS_ALLOWED_ORIGINS=https://your-frontend-domain
EUREKA_DEFAULT_ZONE=http://eureka-server:8761/eureka/
